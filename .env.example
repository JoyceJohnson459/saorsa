# Saorsa — copy to .env and fill in. Never commit .env.
# Generate secrets with:  bun server/src/cli.ts gen-master-key   /   bun server/src/cli.ts gen-bootstrap-token

# Public HTTPS origin members and OpenCode clients use (your reverse proxy).
SAORSA_PUBLIC_URL=https://saorsa.tech

# Docker Compose service passwords (long random values).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# AES-256-GCM master keys for provider API keys: "version:base64(32 bytes)", comma separated for rotation.
# Store these outside the database host's backups (or in a KMS-backed secret store).
SAORSA_MASTER_KEYS=1:
SAORSA_MASTER_KEY_ACTIVE=1

# One-time token for the first admin setup page. Remove it after initialization.
SAORSA_BOOTSTRAP_TOKEN=

# Extra HTTPS upstream hosts admins may register (built-in: api.openai.com, api.anthropic.com, api.deepseek.com,
# open.bigmodel.cn, ark.cn-beijing.volces.com, dashscope.aliyuncs.com, api.moonshot.cn, openrouter.ai).
SAORSA_UPSTREAM_HOST_ALLOWLIST=

# true only when a reverse proxy overwrites X-Forwarded-For.
SAORSA_TRUST_PROXY=true
SAORSA_COOKIE_SECURE=true
SAORSA_HTTP_PORT=8787
SAORSA_LOG_LEVEL=info

# Lifetime (hours) of the per-launch token the Saorsa Launcher hands to a tool process.
SAORSA_TOOL_TOKEN_TTL_HOURS=12

# Upstream must send response headers within this time, then never stay silent longer than the idle timeout.
SAORSA_UPSTREAM_HEADER_TIMEOUT_SECONDS=300
SAORSA_UPSTREAM_IDLE_TIMEOUT_SECONDS=300

# Earlier NEXCODE_* and TEAMOS_* names are still accepted; SAORSA_* wins when several are set.

# --- Local development without Docker (scripts/dev-services.sh) ---
# SAORSA_DATABASE_URL=postgres://teamos@127.0.0.1:55432/teamos
# SAORSA_REDIS_URL=redis://127.0.0.1:56379/0
# SAORSA_PUBLIC_URL=http://127.0.0.1:8787
# SAORSA_ALLOW_PRIVATE_UPSTREAMS=true   # dev/test only: permits the mock upstream on 127.0.0.1
